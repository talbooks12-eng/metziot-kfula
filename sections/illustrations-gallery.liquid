{{ 'book-custom.css' | asset_url | stylesheet_tag }}

<div class="illustrations-gallery color-{{ section.settings.color_scheme }}">
  <div class="illustrations-gallery__container page-width">
    {% if section.settings.heading != blank %}
      <h2 class="illustrations-gallery__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="illustrations-gallery__subheading">{{ section.settings.subheading }}</p>
    {% endif %}

    <div class="illustrations-gallery__grid">
      {% for block in section.blocks %}
        <div class="illustration-card" {{ block.shopify_attributes }}>
          <div class="illustration-card__image-wrapper">
            {% if block.settings.image != blank %}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                alt="{{ block.settings.caption | default: 'איור מהספר' }}"
                class="illustration-card__image"
                loading="lazy"
                width="600"
                height="{{ 600 | divided_by: block.settings.image.aspect_ratio | round }}"
              >
            {% else %}
              <div class="illustration-card__placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="1.5"/>
                  <circle cx="8.5" cy="8.5" r="1.5" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M3 16L8 11L13 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M13 14L16 11L21 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            {% endif %}
          </div>
          {% if block.settings.caption != blank %}
            <p class="illustration-card__caption">{{ block.settings.caption }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .illustrations-gallery {
    padding: clamp(3rem, 8vw, 5rem) 0;
    background: #fff;
  }

  html[dir="rtl"] .illustrations-gallery {
    direction: rtl;
  }

  .illustrations-gallery__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .illustrations-gallery__heading {
    text-align: center;
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--book-text-primary, #1A1A1A);
    margin-bottom: 0.75rem;
  }

  .illustrations-gallery__subheading {
    text-align: center;
    font-size: 1.0625rem;
    color: var(--book-text-secondary, #4A4A4A);
    margin-bottom: 3rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .illustrations-gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .illustrations-gallery__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .illustrations-gallery__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .illustration-card {
    background: var(--book-cream, #F5F2ED);
    border-radius: 8px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .illustration-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
  }

  .illustration-card__image-wrapper {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: #fff;
  }

  .illustration-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1rem;
    transition: transform 0.4s ease;
  }

  .illustration-card:hover .illustration-card__image {
    transform: scale(1.03);
  }

  .illustration-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--book-sand-light, #EBE6E0);
    color: var(--book-text-muted, #7A7A7A);
  }

  .illustration-card__caption {
    padding: 1rem 1.25rem;
    font-size: 0.9375rem;
    color: var(--book-text-secondary, #4A4A4A);
    text-align: center;
    margin: 0;
    border-top: 1px solid var(--book-sand, #D4CBC0);
    background: var(--book-cream, #F5F2ED);
  }

  /* Lightbox effect on click - optional enhancement */
  .illustration-card__image-wrapper {
    cursor: pointer;
  }

  /* Featured/larger card for first image */
  .illustrations-gallery__grid .illustration-card:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  @media (max-width: 767px) {
    .illustrations-gallery__grid .illustration-card:first-child {
      grid-column: span 1;
      grid-row: span 1;
    }
  }

  /* Animation on scroll */
  .illustration-card {
    opacity: 0;
    animation: fadeInUp 0.6s ease forwards;
  }

  .illustration-card:nth-child(1) { animation-delay: 0.1s; }
  .illustration-card:nth-child(2) { animation-delay: 0.15s; }
  .illustration-card:nth-child(3) { animation-delay: 0.2s; }
  .illustration-card:nth-child(4) { animation-delay: 0.25s; }
  .illustration-card:nth-child(5) { animation-delay: 0.3s; }
  .illustration-card:nth-child(6) { animation-delay: 0.35s; }
  .illustration-card:nth-child(7) { animation-delay: 0.4s; }
  .illustration-card:nth-child(8) { animation-delay: 0.45s; }
  .illustration-card:nth-child(9) { animation-delay: 0.5s; }
  .illustration-card:nth-child(10) { animation-delay: 0.55s; }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

{% schema %}
{
  "name": "גלריית איורים",
  "tag": "section",
  "class": "section-illustrations-gallery",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "ערכת צבעים",
      "default": "scheme-1"
