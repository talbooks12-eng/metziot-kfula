{{ 'book-custom.css' | asset_url | stylesheet_tag }}

<div class="book-quotes color-{{ section.settings.color_scheme }}">
  <div class="book-quotes__container page-width">
    {% if section.settings.heading != blank %}
      <h2 class="book-quotes__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="book-quotes__grid">
      {% for block in section.blocks %}
        <blockquote class="book-quote" {{ block.shopify_attributes }}>
          <div class="book-quote__mark">"</div>
          <p class="book-quote__text">{{ block.settings.quote }}</p>
          {% if block.settings.context != blank %}
            <cite class="book-quote__context">— {{ block.settings.context }}</cite>
          {% endif %}
        </blockquote>
      {% endfor %}
    </div>
  </div>
</div>

<style>
  .book-quotes {
    padding: clamp(3rem, 8vw, 5rem) 0;
    background: var(--book-cream, #F5F2ED);
  }

  html[dir="rtl"] .book-quotes {
    direction: rtl;
  }

  .book-quotes__container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .book-quotes__heading {
    text-align: center;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--book-text-primary, #1A1A1A);
    margin-bottom: 3rem;
  }

  .book-quotes__grid {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .book-quotes__grid {
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 2.5rem;
    }
  }

  .book-quote {
    background: #fff;
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .book-quote__mark {
    font-size: 4rem;
    font-family: Georgia, serif;
    color: var(--book-sand, #D4CBC0);
    line-height: 1;
    position: absolute;
    top: 0.5rem;
    right: 1.5rem;
    opacity: 0.6;
  }

  html[dir="ltr"] .book-quote__mark {
    right: auto;
    left: 1.5rem;
  }

  .book-quote__text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--book-text-primary, #1A1A1A);
    margin: 0;
    padding-top: 1rem;
    font-style: italic;
    flex-grow: 1;
  }

  .book-quote__context {
    display: block;
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--book-text-muted, #7A7A7A);
    font-style: normal;
  }

  /* Hover effect */
  .book-quote {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .book-quote:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.1);
  }
</style>

{% schema %}
{
  "name": "ציטוטים מהספר",
  "tag": "section",
  "class": "section-book-quotes",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "ערכת צבעים",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "כותרת",
      "default": "מתוך הספר"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "ציטוט",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "טקסט הציטוט",
          "default": "הכניסו כאן ציטוט מהספר"
        },
        {
          "type": "text",
          "id": "context",
          "label": "הקשר (אופציונלי)",
          "info": "לדוגמה: שם הפרק או מספר עמוד"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ציטוטים מהספר",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "רגע אחד הוא היה שם, בטיול הגדול, נושם אוויר פסגות ומתכנן את החזרה הקרובה לניו-יורק. רגע לאחר מכן- השמיים נפלו.",
            "context": "מתוך הספר"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "זהו לא ספר על אסטרטגיה צבאית, אלא אסופה של רגעים, מחשבות ורגשות של \"חייל קטן\", שמנסה למצוא היגיון בתוך הכאוס ונחמה בתוך החשיכה.",
            "context": "מתוך הספר"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "בכנות שורפת ובשפה ישירה, הספר לוקח את הקורא אל המקומות שבהם המילים נגמרות והלב מדבר.",
            "context": "מתוך הספר"
          }
        }
      ]
    }
  ]
}
{% endschema %}
